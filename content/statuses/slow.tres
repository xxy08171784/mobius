[gd_resource type="Resource" script_class="StatusDef" format=3]

[ext_resource type="Script" path="res://gameplay/effects/statuses/status_def.gd" id="1_slow"]

[resource]
script = ExtResource("1_slow")
status_id = &"status.slow"
display_name = "减速"
description = "每层减少1点主动移动：玩家回合开始的移动点、敌人的接近与突进步数；不影响拉拽和击退。"
