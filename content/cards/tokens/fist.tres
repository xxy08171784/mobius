[gd_resource type="Resource" script_class="CardDef" load_steps=4 format=3]

[ext_resource type="Script" path="res://gameplay/cards/card_def.gd" id="1_card"]
[ext_resource type="Script" path="res://gameplay/effects/configured_effect_def.gd" id="2_effect"]
[ext_resource type="Script" path="res://gameplay/effects/effect_def.gd" id="3_base"]

[sub_resource type="Resource" id="Effect_fist_damage"]
script = ExtResource("2_effect")
type_key = &"damage"
params = {
"amount": 4.0
}

[resource]
script = ExtResource("1_card")
card_id = &"card.token.fist"
card_category = 3
icon_key = &"icon_01"
display_name = "拳"
description = "[消耗] 造成4点伤害。（策划未给出拳牌数值，当前为集中默认值）"
base_cost = 0
reward_pool_enabled = false
tags = Array[StringName]([&"attack"])
effects = Array[ExtResource("3_base")]([SubResource("Effect_fist_damage")])
exhaust_on_play = true
content_target_kind = 1
content_target_team = 2
