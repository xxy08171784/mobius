[gd_resource type="Resource" script_class="CardDef" load_steps=4 format=3]

[ext_resource type="Script" path="res://gameplay/cards/card_def.gd" id="1_card"]
[ext_resource type="Script" path="res://gameplay/effects/configured_effect_def.gd" id="2_effect"]
[ext_resource type="Script" path="res://gameplay/effects/effect_def.gd" id="3_base"]

[sub_resource type="Resource" id="Effect_block"]
script = ExtResource("2_effect")
type_key = &"block"
params = {
"amount": 5,
"target_mode": &"source"
}

[resource]
script = ExtResource("1_card")
card_id = &"card.starter.defend"
card_category = 4
icon_key = &"icon_01"
display_name = "防守"
description = "防御值+5。"
base_cost = 1
reward_pool_enabled = false
tags = Array[StringName]([&"defense"])
effects = Array[ExtResource("3_base")]([SubResource("Effect_block")])
content_target_kind = 0

