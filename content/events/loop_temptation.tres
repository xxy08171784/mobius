[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://gameplay/run/event_choice.gd" id="1_choice"]
[ext_resource type="Script" path="res://gameplay/run/event_def.gd" id="2_event"]

[sub_resource type="Resource" id="Resource_c1"]
script = ExtResource("1_choice")
label = "触碰回环，失去 5 点生命，获得 60 金币"
hp_delta = -5
gold_delta = 60

[sub_resource type="Resource" id="Resource_c2"]
script = ExtResource("1_choice")
label = "转身离开，一无所获"

[resource]
script = ExtResource("2_event")
id = &"event.loop_temptation"
title = "回环的低语"
body = "一圈微光在空中缓慢自转，低声许诺着财富，代价是你的鲜血。"
choices = Array[ExtResource("1_choice")]([SubResource("Resource_c1"), SubResource("Resource_c2")])
