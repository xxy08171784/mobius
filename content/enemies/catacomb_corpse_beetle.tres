[gd_resource type="Resource" script_class="EnemyDef" format=3]

[ext_resource type="Script" path="res://gameplay/enemies/sequence_behavior_def.gd" id="1_seq"]
[ext_resource type="Script" path="res://gameplay/enemies/enemy_action_def.gd" id="2_act"]
[ext_resource type="Script" path="res://gameplay/enemies/enemy_def.gd" id="3_def"]

[sub_resource type="Resource" id="act_approach"]
script = ExtResource("2_act")
id = &"corpse_beetle.approach"
kind = 1
target_policy = 0
move_steps = 2

[sub_resource type="Resource" id="act_bite"]
script = ExtResource("2_act")
id = &"corpse_beetle.bite"
kind = 0
target_policy = 0
range = 1
range_shape = 1
damage_min = 7
damage_max = 9
advance_steps = 2

[sub_resource type="Resource" id="act_carapace"]
script = ExtResource("2_act")
id = &"corpse_beetle.carapace"
kind = 3
target_policy = 1
block_min = 4
block_max = 6

[sub_resource type="Resource" id="behavior"]
script = ExtResource("1_seq")
sequence = Array[ExtResource("2_act")]([SubResource("act_approach"), SubResource("act_bite"), SubResource("act_carapace")])
id = &"enemy.catacomb.corpse_beetle.behavior"
fallback_action_id = &"corpse_beetle.bite"

[resource]
script = ExtResource("3_def")
id = &"enemy.catacomb.corpse_beetle"
unit_def_id = &"unit.enemy.catacomb.corpse_beetle"
behavior = SubResource("behavior")
appearance_key = &"catacomb_corpse_beetle"
display_name = "尸鳖"
