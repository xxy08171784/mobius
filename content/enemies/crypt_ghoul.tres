[gd_resource type="Resource" script_class="EnemyDef" format=3]

[ext_resource type="Script" path="res://gameplay/enemies/sequence_behavior_def.gd" id="1_seq"]
[ext_resource type="Script" path="res://gameplay/enemies/enemy_action_def.gd" id="2_act"]
[ext_resource type="Script" path="res://gameplay/enemies/enemy_def.gd" id="3_def"]

[sub_resource type="Resource" id="act_approach"]
script = ExtResource("2_act")
id = &"ghoul.approach"
kind = 1
target_policy = 0
move_steps = 3

[sub_resource type="Resource" id="act_claw"]
script = ExtResource("2_act")
id = &"ghoul.claw"
kind = 0
target_policy = 0
range = 1
range_shape = 1
damage = 7
advance_steps = 3

[sub_resource type="Resource" id="act_lick"]
script = ExtResource("2_act")
id = &"ghoul.lick"
kind = 0
target_policy = 0
range = 1
range_shape = 1
apply_status_id = &"status.corrode"
apply_status_stacks = 2
apply_status_duration = 2
advance_steps = 3

[sub_resource type="Resource" id="behavior"]
script = ExtResource("1_seq")
sequence = Array[ExtResource("2_act")]([SubResource("act_approach"), SubResource("act_claw"), SubResource("act_lick")])
id = &"enemy.crypt.ghoul.behavior"
fallback_action_id = &"ghoul.claw"

[resource]
script = ExtResource("3_def")
id = &"enemy.crypt.ghoul"
unit_def_id = &"unit.enemy.crypt.ghoul"
behavior = SubResource("behavior")
appearance_key = &"crypt_ghoul"
display_name = "食尸鬼"
