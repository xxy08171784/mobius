[gd_resource type="Resource" script_class="EnemyDef" format=3]

[ext_resource type="Script" path="res://gameplay/enemies/sequence_behavior_def.gd" id="1_seq"]
[ext_resource type="Script" path="res://gameplay/enemies/enemy_action_def.gd" id="2_act"]
[ext_resource type="Script" path="res://gameplay/enemies/enemy_def.gd" id="3_def"]

[sub_resource type="Resource" id="act_coffin_blow"]
script = ExtResource("2_act")
id = &"tomb_master.coffin_blow"
kind = 0
target_policy = 0
range = 1
range_shape = 1
damage = 12
advance_steps = 3

[sub_resource type="Resource" id="act_defense"]
script = ExtResource("2_act")
id = &"tomb_master.defense"
kind = 3
target_policy = 1
block = 8

[sub_resource type="Resource" id="act_summon_guard"]
script = ExtResource("2_act")
id = &"tomb_master.summon_guard"
kind = 5
target_policy = 2

[sub_resource type="Resource" id="behavior"]
script = ExtResource("1_seq")
sequence = Array[ExtResource("2_act")]([SubResource("act_coffin_blow"), SubResource("act_defense"), SubResource("act_summon_guard")])
id = &"enemy.crypt.tomb_master.behavior"
fallback_action_id = &"tomb_master.coffin_blow"

[resource]
script = ExtResource("3_def")
id = &"enemy.crypt.tomb_master"
unit_def_id = &"unit.enemy.crypt.tomb_master"
behavior = SubResource("behavior")
appearance_key = &"crypt_tomb_master"
display_name = "墓主人"
