[gd_resource type="Resource" script_class="EnemyDef" format=3]

[ext_resource type="Script" path="res://gameplay/enemies/sequence_behavior_def.gd" id="1_seq"]
[ext_resource type="Script" path="res://gameplay/enemies/enemy_action_def.gd" id="2_act"]
[ext_resource type="Script" path="res://gameplay/enemies/enemy_def.gd" id="3_def"]
[ext_resource type="Script" path="res://gameplay/enemies/reaction_def.gd" id="4_react"]

[sub_resource type="Resource" id="act_approach"]
script = ExtResource("2_act")
id = &"stone_figure.approach"
kind = 1
target_policy = 0
move_steps = 3

[sub_resource type="Resource" id="act_heavy_blow"]
script = ExtResource("2_act")
id = &"stone_figure.heavy_blow"
kind = 0
target_policy = 0
range = 1
range_shape = 1
damage_min = 9
damage_max = 12
advance_steps = 3

[sub_resource type="Resource" id="act_rock_armor"]
script = ExtResource("2_act")
id = &"stone_figure.rock_armor"
kind = 3
target_policy = 1
block_min = 8
block_max = 12

[sub_resource type="Resource" id="behavior"]
script = ExtResource("1_seq")
sequence = Array[ExtResource("2_act")]([SubResource("act_approach"), SubResource("act_heavy_blow"), SubResource("act_rock_armor")])
id = &"enemy.catacomb.stone_figure.behavior"
fallback_action_id = &"stone_figure.heavy_blow"

[sub_resource type="Resource" id="react_crack"]
script = ExtResource("4_react")
event_type = &"on_damaged"
kind = 0
amount = 2

[resource]
script = ExtResource("3_def")
id = &"enemy.catacomb.stone_figure"
unit_def_id = &"unit.enemy.catacomb.stone_figure"
behavior = SubResource("behavior")
appearance_key = &"catacomb_stone_figure"
display_name = "石俑"
reactions = Array[ExtResource("4_react")]([SubResource("react_crack")])
