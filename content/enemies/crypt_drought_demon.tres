[gd_resource type="Resource" script_class="EnemyDef" format=3]

[ext_resource type="Script" path="res://gameplay/enemies/sequence_behavior_def.gd" id="1_seq"]
[ext_resource type="Script" path="res://gameplay/enemies/enemy_action_def.gd" id="2_act"]
[ext_resource type="Script" path="res://gameplay/enemies/enemy_def.gd" id="3_def"]

[sub_resource type="Resource" id="act_approach"]
script = ExtResource("2_act")
id = &"drought_demon.approach"
kind = 1
target_policy = 0
move_steps = 3

[sub_resource type="Resource" id="act_hot_claw"]
script = ExtResource("2_act")
id = &"drought_demon.hot_claw"
kind = 0
target_policy = 0
range = 1
range_shape = 1
damage = 8
apply_status_id = &"status.ignite"
apply_status_stacks = 1
apply_status_duration = 2
advance_steps = 3

[sub_resource type="Resource" id="act_drought_shock"]
script = ExtResource("2_act")
id = &"drought_demon.drought_shock"
kind = 0
target_policy = 0
range = 2
range_shape = 0
damage = 5
advance_steps = 3

[sub_resource type="Resource" id="behavior"]
script = ExtResource("1_seq")
sequence = Array[ExtResource("2_act")]([SubResource("act_approach"), SubResource("act_hot_claw"), SubResource("act_drought_shock")])
id = &"enemy.crypt.drought_demon.behavior"
fallback_action_id = &"drought_demon.hot_claw"

[resource]
script = ExtResource("3_def")
id = &"enemy.crypt.drought_demon"
unit_def_id = &"unit.enemy.crypt.drought_demon"
behavior = SubResource("behavior")
appearance_key = &"crypt_drought_demon"
display_name = "旱魃"
