[gd_resource type="Resource" script_class="EnemyDef" format=3]

[ext_resource type="Script" path="res://gameplay/enemies/sequence_behavior_def.gd" id="1_seq"]
[ext_resource type="Script" path="res://gameplay/enemies/enemy_action_def.gd" id="2_act"]
[ext_resource type="Script" path="res://gameplay/enemies/enemy_def.gd" id="3_def"]

[sub_resource type="Resource" id="act_approach"]
script = ExtResource("2_act")
id = &"lizardman.approach"
kind = 1
target_policy = 0
move_steps = 3

[sub_resource type="Resource" id="act_twin_slash"]
script = ExtResource("2_act")
id = &"lizardman.twin_slash"
kind = 0
target_policy = 0
range = 1
range_shape = 1
damage = 7
hit_count = 2
advance_steps = 2

[sub_resource type="Resource" id="act_guard"]
script = ExtResource("2_act")
id = &"lizardman.guard"
kind = 3
target_policy = 1
block = 8

[sub_resource type="Resource" id="act_clamp"]
script = ExtResource("2_act")
id = &"lizardman.clamp"
kind = 0
target_policy = 0
range = 1
range_shape = 1
apply_status_id = &"status.slow"
apply_status_stacks = 1
apply_status_duration = 2
advance_steps = 2

[sub_resource type="Resource" id="behavior"]
script = ExtResource("1_seq")
sequence = Array[ExtResource("2_act")]([SubResource("act_approach"), SubResource("act_twin_slash"), SubResource("act_guard"), SubResource("act_clamp")])
id = &"enemy.crypt.lizardman.behavior"
fallback_action_id = &"lizardman.twin_slash"

[resource]
script = ExtResource("3_def")
id = &"enemy.crypt.lizardman"
unit_def_id = &"unit.enemy.crypt.lizardman"
behavior = SubResource("behavior")
appearance_key = &"crypt_lizardman"
display_name = "蜥蜴人"
