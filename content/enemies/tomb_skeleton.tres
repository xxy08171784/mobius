[gd_resource type="Resource" script_class="EnemyDef" format=3]

[ext_resource type="Script" path="res://gameplay/enemies/sequence_behavior_def.gd" id="1_seq"]
[ext_resource type="Script" path="res://gameplay/enemies/enemy_action_def.gd" id="2_act"]
[ext_resource type="Script" path="res://gameplay/enemies/enemy_def.gd" id="3_def"]

[sub_resource type="Resource" id="act_slash"]
script = ExtResource("2_act")
id = &"skeleton.slash"
kind = 0
target_policy = 0
range = 2
range_shape = 1
damage = 6
advance_steps = 2

[sub_resource type="Resource" id="act_heavy"]
script = ExtResource("2_act")
id = &"skeleton.heavy"
kind = 0
target_policy = 0
range = 2
range_shape = 1
damage = 10
advance_steps = 2

[sub_resource type="Resource" id="act_guard"]
script = ExtResource("2_act")
id = &"skeleton.guard"
kind = 3
target_policy = 1
block = 6

[sub_resource type="Resource" id="behavior"]
script = ExtResource("1_seq")
sequence = Array[ExtResource("2_act")]([SubResource("act_slash"), SubResource("act_heavy"), SubResource("act_guard")])
id = &"enemy.tomb.skeleton.behavior"
fallback_action_id = &"skeleton.slash"

[resource]
script = ExtResource("3_def")
id = &"enemy.tomb.skeleton"
unit_def_id = &"unit.enemy.tomb.skeleton"
behavior = SubResource("behavior")
appearance_key = &"tomb_skeleton"
display_name = "朽骨骷髅"
