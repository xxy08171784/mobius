[gd_resource type="Resource" script_class="EnemyDef" format=3]

[ext_resource type="Script" path="res://gameplay/enemies/sequence_behavior_def.gd" id="1_seq"]
[ext_resource type="Script" path="res://gameplay/enemies/enemy_action_def.gd" id="2_act"]
[ext_resource type="Script" path="res://gameplay/enemies/enemy_def.gd" id="3_def"]

[sub_resource type="Resource" id="act_approach"]
script = ExtResource("2_act")
id = &"clay_figure.approach"
kind = 1
target_policy = 0
move_steps = 3

[sub_resource type="Resource" id="act_mud_jets"]
script = ExtResource("2_act")
id = &"clay_figure.mud_jets"
kind = 0
target_policy = 0
range = 1
range_shape = 1
damage = 8
apply_status_id = &"status.slow"
apply_status_stacks = 1
apply_status_duration = 2
advance_steps = 2

[sub_resource type="Resource" id="act_solidify"]
script = ExtResource("2_act")
id = &"clay_figure.solidify"
kind = 3
target_policy = 1
block = 9

[sub_resource type="Resource" id="behavior"]
script = ExtResource("1_seq")
sequence = Array[ExtResource("2_act")]([SubResource("act_approach"), SubResource("act_mud_jets"), SubResource("act_solidify")])
id = &"enemy.catacomb.clay_figure.behavior"
fallback_action_id = &"clay_figure.mud_jets"

[resource]
script = ExtResource("3_def")
id = &"enemy.catacomb.clay_figure"
unit_def_id = &"unit.enemy.catacomb.clay_figure"
behavior = SubResource("behavior")
appearance_key = &"catacomb_clay_figure"
display_name = "泥俑"
