[gd_resource type="Resource" script_class="EnemyDef" format=3]

[ext_resource type="Script" path="res://gameplay/enemies/sequence_behavior_def.gd" id="1_seq"]
[ext_resource type="Script" path="res://gameplay/enemies/enemy_action_def.gd" id="2_act"]
[ext_resource type="Script" path="res://gameplay/enemies/enemy_def.gd" id="3_def"]

[sub_resource type="Resource" id="act_approach"]
script = ExtResource("2_act")
id = &"stone_lion.approach"
kind = 1
target_policy = 0
move_steps = 2

[sub_resource type="Resource" id="act_heavy_stone"]
script = ExtResource("2_act")
id = &"stone_lion.heavy_stone"
kind = 0
target_policy = 0
range = 1
range_shape = 1
damage = 7
advance_steps = 2

[sub_resource type="Resource" id="act_stone_skin"]
script = ExtResource("2_act")
id = &"stone_lion.stone_skin"
kind = 3
target_policy = 1
block = 5

[sub_resource type="Resource" id="behavior"]
script = ExtResource("1_seq")
sequence = Array[ExtResource("2_act")]([SubResource("act_approach"), SubResource("act_heavy_stone"), SubResource("act_stone_skin")])
id = &"enemy.crypt.stone_lion.behavior"
fallback_action_id = &"stone_lion.heavy_stone"

[resource]
script = ExtResource("3_def")
id = &"enemy.crypt.stone_lion"
unit_def_id = &"unit.enemy.crypt.stone_lion"
behavior = SubResource("behavior")
appearance_key = &"crypt_stone_lion"
display_name = "石狮子"
