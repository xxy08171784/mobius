[gd_resource type="Resource" script_class="EnemyDef" format=3]

[ext_resource type="Script" path="res://gameplay/enemies/sequence_behavior_def.gd" id="1_seq"]
[ext_resource type="Script" path="res://gameplay/enemies/enemy_action_def.gd" id="2_act"]
[ext_resource type="Script" path="res://gameplay/enemies/enemy_def.gd" id="3_def"]

[sub_resource type="Resource" id="act_dash"]
script = ExtResource("2_act")
id = &"statue.dash"
kind = 4
target_policy = 0
move_steps = 3
damage = 6
dash_damage_per_step = 3

[sub_resource type="Resource" id="act_smash"]
script = ExtResource("2_act")
id = &"statue.smash"
kind = 0
target_policy = 0
range = 2
range_shape = 1
damage = 8
advance_steps = 3

[sub_resource type="Resource" id="act_guard"]
script = ExtResource("2_act")
id = &"statue.guard"
kind = 3
target_policy = 1
block = 7

[sub_resource type="Resource" id="act_summon"]
script = ExtResource("2_act")
id = &"statue.summon"
kind = 5
target_policy = 2

[sub_resource type="Resource" id="behavior"]
script = ExtResource("1_seq")
sequence = Array[ExtResource("2_act")]([SubResource("act_dash"), SubResource("act_smash"), SubResource("act_guard"), SubResource("act_summon")])
id = &"enemy.tomb.tomb_statue.behavior"
fallback_action_id = &"statue.smash"

[resource]
script = ExtResource("3_def")
id = &"enemy.tomb.tomb_statue"
unit_def_id = &"unit.enemy.tomb.tomb_statue"
behavior = SubResource("behavior")
appearance_key = &"tomb_statue"
display_name = "陵墓石像"
