[gd_resource type="Resource" script_class="EnemyDef" format=3]

[ext_resource type="Script" path="res://gameplay/enemies/sequence_behavior_def.gd" id="1_seq"]
[ext_resource type="Script" path="res://gameplay/enemies/enemy_action_def.gd" id="2_act"]
[ext_resource type="Script" path="res://gameplay/enemies/enemy_def.gd" id="3_def"]

[sub_resource type="Resource" id="act_approach"]
script = ExtResource("2_act")
id = &"spider.approach"
kind = 1
target_policy = 0
move_steps = 2

[sub_resource type="Resource" id="act_venom"]
script = ExtResource("2_act")
id = &"spider.venom"
kind = 0
target_policy = 0
range = 1
range_shape = 1
apply_status_id = &"status.poison"
apply_status_stacks = 2
apply_status_duration = 99
advance_steps = 2

[sub_resource type="Resource" id="act_web"]
script = ExtResource("2_act")
id = &"spider.web"
kind = 0
target_policy = 0
range = 1
range_shape = 1
apply_status_id = &"status.entangle"
apply_status_stacks = 1
apply_status_duration = 2
advance_steps = 2

[sub_resource type="Resource" id="behavior"]
script = ExtResource("1_seq")
sequence = Array[ExtResource("2_act")]([SubResource("act_approach"), SubResource("act_venom"), SubResource("act_web")])
id = &"enemy.catacomb.spider.behavior"
fallback_action_id = &"spider.venom"

[resource]
script = ExtResource("3_def")
id = &"enemy.catacomb.spider"
unit_def_id = &"unit.enemy.catacomb.spider"
behavior = SubResource("behavior")
appearance_key = &"catacomb_spider"
display_name = "蜘蛛"
