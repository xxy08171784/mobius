[gd_resource type="Resource" script_class="EnemyDef" format=3]

[ext_resource type="Script" path="res://gameplay/enemies/sequence_behavior_def.gd" id="1_seq"]
[ext_resource type="Script" path="res://gameplay/enemies/enemy_action_def.gd" id="2_act"]
[ext_resource type="Script" path="res://gameplay/enemies/enemy_def.gd" id="3_def"]

[sub_resource type="Resource" id="act_march"]
script = ExtResource("2_act")
id = &"ghost_soldier.march"
kind = 0
target_policy = 0
range = 1
range_shape = 1
damage = 10
pierce = true
advance_steps = 3

[sub_resource type="Resource" id="act_hook"]
script = ExtResource("2_act")
id = &"ghost_soldier.hook"
kind = 6
target_policy = 0
range = 2
range_shape = 1
move_steps = 2
dash_damage_per_step = 3

[sub_resource type="Resource" id="act_ward"]
script = ExtResource("2_act")
id = &"ghost_soldier.ward"
kind = 3
target_policy = 1
block = 12
cleanse = true

[sub_resource type="Resource" id="act_summon"]
script = ExtResource("2_act")
id = &"ghost_soldier.summon"
kind = 5
target_policy = 2

[sub_resource type="Resource" id="behavior"]
script = ExtResource("1_seq")
sequence = Array[ExtResource("2_act")]([SubResource("act_march"), SubResource("act_hook"), SubResource("act_ward"), SubResource("act_march"), SubResource("act_hook"), SubResource("act_summon")])
id = &"enemy.catacomb.ghost_soldier.behavior"
fallback_action_id = &"ghost_soldier.march"

[resource]
script = ExtResource("3_def")
id = &"enemy.catacomb.ghost_soldier"
unit_def_id = &"unit.enemy.catacomb.ghost_soldier"
behavior = SubResource("behavior")
appearance_key = &"catacomb_ghost_soldier"
display_name = "阴兵"
