[gd_resource type="Resource" script_class="EnemyDef" format=3]

[ext_resource type="Script" path="res://gameplay/enemies/sequence_behavior_def.gd" id="1_seq"]
[ext_resource type="Script" path="res://gameplay/enemies/enemy_action_def.gd" id="2_act"]
[ext_resource type="Script" path="res://gameplay/enemies/enemy_def.gd" id="3_def"]

[sub_resource type="Resource" id="act_shot"]
script = ExtResource("2_act")
id = &"crossbow.shot"
kind = 0
target_policy = 0
range = 4
range_shape = 1
damage = 6
kiting = true
advance_steps = 1
requires_los = true

[sub_resource type="Resource" id="act_volley"]
script = ExtResource("2_act")
id = &"crossbow.volley"
kind = 0
target_policy = 0
range = 4
range_shape = 1
damage = 3
hit_count = 2
kiting = true
advance_steps = 1
requires_los = true

[sub_resource type="Resource" id="behavior"]
script = ExtResource("1_seq")
sequence = Array[ExtResource("2_act")]([SubResource("act_shot"), SubResource("act_volley")])
id = &"enemy.tomb.crossbow.behavior"
fallback_action_id = &"crossbow.shot"

[resource]
script = ExtResource("3_def")
id = &"enemy.tomb.crossbow"
unit_def_id = &"unit.enemy.tomb.crossbow"
behavior = SubResource("behavior")
appearance_key = &"tomb_crossbow"
display_name = "弩俑"
